# Copy to .env.local and fill in. All of these are NEXT_PUBLIC_ values: they are compiled into the browser bundle
# at build time, so set them in your hosting provider's build environment too.

# Stripe pricing table shown on the account page
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Firebase Authentication tenant for Strapi Page Builder accounts
NEXT_PUBLIC_FIREBASE_TENANT_ID=

# Firebase web app configuration (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Analytics 4 measurement id (optional: analytics is off when empty)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Stripe customer portal login link for the "Manage subscription" button (optional: the button is hidden when empty)
NEXT_PUBLIC_STRIPE_BILLING_PORTAL_URL=

# Licence server endpoint used by the account page (optional; defaults to https://licence.wc8.io/strapi-page-builder/auth)
NEXT_PUBLIC_LICENCE_SERVER_URL=
